<UserControl x:Class="BetaFit.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="26" FontWeight="Black" Foreground="{StaticResource BfText}" />
        <TextBlock Text="Visão geral do catálogo Beta Fit." Foreground="{StaticResource BfMuted}" Margin="0,4,0,24" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BfDanger}" Margin="0,0,0,12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}" />

        <UniformGrid Columns="4" Rows="1">
            <Border Background="{StaticResource BfSurface}" BorderBrush="{StaticResource BfBorder}" BorderThickness="1" Margin="0,0,12,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Produtos" Foreground="{StaticResource BfMuted}" FontSize="12" />
                    <TextBlock Text="{Binding Summary.TotalProducts}" Foreground="{StaticResource BfAccent}" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BfSurface}" BorderBrush="{StaticResource BfBorder}" BorderThickness="1" Margin="0,0,12,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Produtos ativos" Foreground="{StaticResource BfMuted}" FontSize="12" />
                    <TextBlock Text="{Binding Summary.ActiveProducts}" Foreground="{StaticResource BfText}" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BfSurface}" BorderBrush="{StaticResource BfBorder}" BorderThickness="1" Margin="0,0,12,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Em destaque" Foreground="{StaticResource BfMuted}" FontSize="12" />
                    <TextBlock Text="{Binding Summary.FeaturedProducts}" Foreground="{StaticResource BfText}" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BfSurface}" BorderBrush="{StaticResource BfBorder}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Categorias" Foreground="{StaticResource BfMuted}" FontSize="12" />
                    <TextBlock Text="{Binding Summary.TotalCategories}" Foreground="{StaticResource BfText}" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Content="Atualizar" Style="{StaticResource BfSecondaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0"
                Command="{Binding LoadCommand}" />
    </StackPanel>
</UserControl>
