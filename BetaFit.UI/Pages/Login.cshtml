@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}
<div class="bf-container bf-auth">
    <h1>Entrar</h1>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-warning">@Model.ErrorMessage</div> }
    <form method="post" class="bf-form">
        <label>E-mail<input asp-for="Email" type="email" required /></label>
        <label>Senha<input asp-for="Password" type="password" required /></label>
        <button class="bf-btn bf-btn--primary" type="submit">Entrar</button>
    </form>
    <p>Não possui conta? <a href="/Register">Cadastre-se</a></p>
</div>
